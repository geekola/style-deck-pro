# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string from Railway
# Dashboard → your project → PostgreSQL → Connect → copy the "Public URL"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Must match your actual deployment URL in production; use http://localhost:3000 locally
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth client
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# dashboard.stripe.com → Developers → Webhooks → Add endpoint
# Endpoint URL: https://YOUR_DOMAIN/api/webhooks/stripe
# Events to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (email) ───────────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_...

# Must be a verified domain in your Resend account
FROM_EMAIL=noreply@yourdomain.com

# ─── Vercel Blob (image storage) ─────────────────────────────────────────────
# Auto-injected by Vercel when you add a Blob store to the project.
# For local dev: vercel env pull (requires Vercel CLI + project linked)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── App ──────────────────────────────────────────────────────────────────────
# Public — accessible in browser code. No secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
